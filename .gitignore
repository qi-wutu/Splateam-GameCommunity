# 环境变量（含密码）
.env
config/.env
config/*.env

# 编译产物
*.exe
*.exe~
*.dll
*.so
*.dylib
tmp/

# 日志
*.log
logs/

# 本地私有文档（不进仓库）
docs_local/

# 严禁提交 yml/yaml（曾泄露数据库密码，一律排除）
*.yml
*.yaml

# Agent 副产物（AI 工具生成的配置/记录，不进仓库）
.claude/
.cursor/
.aider/
.codeium/
.continue/

# WS 压测产物（ws_test/ 下运行时生成）
ws_test/node_modules/
ws_test/tokens.txt
ws_test/*.exe

# IDE
.vscode/
.idea/
*.swp
*.swo

# 系统
.DS_Store
Thumbs.db
