# ============================================================
# 环境变量示例模板 —— config/.env.example
# 复制一份为 config/.env 并填入真实值（.env 已被 gitignore，不会提交）
# 代码读取方式见 config/config.go 的 GetEnv()；下方注释标注了各键的默认值
# ============================================================

# ---- MySQL ----
DB_HOST=127.0.0.1        # 默认 127.0.0.1
DB_PORT=3306             # 默认 3306
DB_USER=root             # 默认 root
DB_PASSWORD=             # 默认空 —— 必须改，别用真实密码提交
DB_NAME=splatoon         # 默认 splatoon

# ---- 服务 ----
SERVER_PORT=8080         # 默认 8080
# JWT 签名密钥 —— 必须设成 ≥32 字符的强随机串（空/默认/过短会导致启动校验失败，拒绝启动）
JWT_SECRET=

# ---- Redis（在线状态 / 消息缓存，可选，连不上会降级不阻塞启动）----
REDIS_ADDR=127.0.0.1:6379   # 默认 127.0.0.1:6379
REDIS_PASSWORD=             # 默认空

# ---- RabbitMQ（异步邮件 worker，可选，连不上会降级）----
RABBITMQ_URL=amqp://guest:guest@localhost:5672/   # 默认如左

# ---- SMTP（邮件发送）----
SMTP_HOST=smtp.qq.com      # 默认 smtp.qq.com
SMTP_PORT=587              # 默认 587
SMTP_USER=                 # 默认空（如 your@qq.com）
SMTP_PASSWORD=             # 默认空（SMTP 授权码，别提交）